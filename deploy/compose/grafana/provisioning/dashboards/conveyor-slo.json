{
  "uid": "conveyor-slo",
  "title": "Conveyor \u2014 SLOs and overload",
  "tags": [
    "conveyor",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Checkout availability (30 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(gateway_edge_requests_seconds_count{priority=\"critical\",outcome=~\"server_error|shed\"}[30d])) / sum(increase(gateway_edge_requests_seconds_count{priority=\"critical\"}[30d])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Objective 99.9 %: orders answered without a 5xx and without being shed."
    },
    {
      "type": "stat",
      "title": "Checkout error budget left (30 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(gateway_edge_requests_seconds_count{priority=\"critical\",outcome=~\"server_error|shed\"}[30d])) / sum(increase(gateway_edge_requests_seconds_count{priority=\"critical\"}[30d]))) / 0.001"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "1 = untouched, 0 = spent. Budget: 0.1 % of orders."
    },
    {
      "type": "stat",
      "title": "Checkout under 300 ms (30 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gateway_edge_requests_seconds_bucket{priority=\"critical\",outcome=\"ok\",le=\"0.3\"}[30d])) / sum(increase(gateway_edge_requests_seconds_count{priority=\"critical\",outcome=\"ok\"}[30d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Objective 99 % of good checkout requests within 300 ms."
    },
    {
      "type": "stat",
      "title": "Browse availability (30 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gateway_edge_requests_seconds_count{priority=~\"normal|sheddable\",outcome=\"ok\"}[30d])) / sum(increase(gateway_edge_requests_seconds_count{priority=~\"normal|sheddable\"}[30d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Objective 99 %. Shedding browse traffic is designed degradation; this is its budget."
    },
    {
      "type": "timeseries",
      "title": "Checkout burn rate (error ratio / budget)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:checkout_errors:ratio_rate5m / 0.001",
          "legendFormat": "5 m"
        },
        {
          "refId": "B",
          "expr": "slo:checkout_errors:ratio_rate1h / 0.001",
          "legendFormat": "1 h"
        },
        {
          "refId": "C",
          "expr": "slo:checkout_errors:ratio_rate6h / 0.001",
          "legendFormat": "6 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "1 = burning exactly the budget. Page at 14.4 (1 h and 5 m), ticket at 6 (6 h and 30 m)."
    },
    {
      "type": "timeseries",
      "title": "Edge requests by priority and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (priority, outcome) (rate(gateway_edge_requests_seconds_count[1m]))",
          "legendFormat": "{{priority}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Admission: concurrency limit vs in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(gateway_concurrency_limit)",
          "legendFormat": "limit"
        },
        {
          "refId": "B",
          "expr": "max(gateway_concurrency_inflight)",
          "legendFormat": "in flight"
        },
        {
          "refId": "C",
          "expr": "max(gateway_concurrency_limit) * 0.6",
          "legendFormat": "product pages may use"
        },
        {
          "refId": "D",
          "expr": "max(gateway_concurrency_limit) * 0.4",
          "legendFormat": "search may use"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The adaptive limit follows upstream latency; lower priorities get a share of it."
    },
    {
      "type": "timeseries",
      "title": "p99 at the edge by priority",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (priority, le) (rate(gateway_edge_requests_seconds_bucket{outcome=\"ok\"}[1m])))",
          "legendFormat": "{{priority}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Catalog circuit breaker (order-svc)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (resilience4j_circuitbreaker_state{name=\"catalog\"})",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(resilience4j_circuitbreaker_not_permitted_calls_total{name=\"catalog\"}[1m]))",
          "legendFormat": "refused per s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "1 on the current state. While open, orders are refused at once instead of waiting 1.5 s for a sick catalog."
    },
    {
      "type": "timeseries",
      "title": "Saga outcomes and tracking pipeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(fulfillment_sagas_started_total[5m]))",
          "legendFormat": "saga {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tracking_live_delay_seconds_bucket[1m])))",
          "legendFormat": "live delay p99 (s)"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tracking_persist_delay_seconds_bucket[1m])))",
          "legendFormat": "persist delay p99 (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Deal waiting room: in line, admitted, admission rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deal) (deal_waiting)",
          "legendFormat": "{{deal}} in line"
        },
        {
          "refId": "B",
          "expr": "max by (deal) (deal_admitted)",
          "legendFormat": "{{deal}} admitted"
        },
        {
          "refId": "C",
          "expr": "max by (deal) (deal_admission_rate)",
          "legendFormat": "{{deal}} admissions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Checkout lanes: deal vs regular, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (lane, outcome) (rate(gateway_edge_requests_seconds_count{priority=\"critical\"}[1m]))",
          "legendFormat": "{{lane}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "editable": false,
  "description": "Edge SLIs from the gateway's LoadSheddingFilter; rules in deploy/compose/prometheus/slo.rules.yml."
}
