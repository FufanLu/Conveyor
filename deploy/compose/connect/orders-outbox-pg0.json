{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres-0",
  "database.port": "5432",
  "database.user": "conveyor",
  "database.password": "conveyor",
  "database.dbname": "orders",
  "topic.prefix": "orders-pg0",
  "slot.name": "orders_outbox_pg0",
  "publication.name": "orders_outbox",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.outbox",
  "snapshot.mode": "no_data",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "10000",
  "poll.interval.ms": "50",
  "transforms": "dropHeartbeats,outbox",
  "transforms.dropHeartbeats.type": "org.apache.kafka.connect.transforms.Filter",
  "transforms.dropHeartbeats.predicate": "isHeartbeat",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "isHeartbeat",
  "transforms.outbox.negate": "true",
  "transforms.outbox.route.topic.replacement": "${routedByValue}.events",
  "transforms.outbox.table.fields.additional.placement": "type:header:eventType,id:header:eventId",
  "predicates": "isHeartbeat",
  "predicates.isHeartbeat.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isHeartbeat.pattern": "__debezium-heartbeat.*",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
  "topic.creation.default.partitions": "12",
  "topic.creation.default.replication.factor": "1"
}
